# Copy this file to .env.local and fill in the two values.
# Supabase dashboard > Project Settings > API (or "API Keys").
# Use the project URL and the anon / publishable key. Never put the service_role key here.
#
# Leave both empty and Compass runs as the original demo: sample data, nothing saved to a server.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
